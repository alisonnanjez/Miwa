<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Transport – Miwa</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="/styles.css" rel="stylesheet"/>
</head>
<body>

  <nav class="navbar navbar-expand-lg miwa-nav">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/">
        <img src="/photos/Sugarcane_Logo.jpeg" alt="Miwa Logo" class="nav-logo"/>
        Miwa
      </a>
      <div class="navbar-nav ms-auto d-flex flex-row gap-1">
        <a class="nav-link" href="/">Home</a>
        <a class="nav-link" href="/permits">Permits</a>
        <a class="nav-link" href="/bookings">Bookings</a>
        <a class="nav-link active" href="/transport">Transport</a>
        <a class="nav-link" href="/analytics">Analytics</a>
      </div>
    </div>
  </nav>

  <!-- Page header -->
  <div class="page-header" style="background-image: url('/photos/field_six.jpg')">
    <div class="container page-header-content">
      <div class="text-white">
        <span class="hero-eyebrow">Miwa System</span>
        <h2 class="fw-bold mt-2 mb-1">Transport Optimization</h2>
        <p class="mb-0" style="color:rgba(255,255,255,0.7)">The most efficient pickup route for all scheduled bookings.</p>
      </div>
    </div>
  </div>

  <div class="container my-5">

    <!-- Summary bar -->
    <div id="routeSummary" class="route-summary-bar mb-5 d-none">
      <div class="row text-center g-3">
        <div class="col-4">
          <p class="summary-label">Total Stops</p>
          <h3 class="summary-value" id="totalStops">—</h3>
        </div>
        <div class="col-4">
          <p class="summary-label">Next Pickup</p>
          <h3 class="summary-value" id="nextPickup">—</h3>
        </div>
        <div class="col-4">
          <p class="summary-label">Truck Assigned</p>
          <h3 class="summary-value" id="truckAssigned">—</h3>
        </div>
      </div>
    </div>

    <!-- Empty state -->
    <div id="emptyState" class="text-center py-5 d-none">
      <div style="font-size:3rem">🚛</div>
      <h5 class="mt-3 fw-bold">No Scheduled Bookings</h5>
      <p class="text-muted">There are no pickups scheduled right now. Go to <a href="/bookings">Bookings</a> to create one.</p>
    </div>

    <!-- Route stop cards -->
    <div id="routeStops"></div>

  </div>

  <footer>© 2026 Miwa Logistics · Built with Express & SQLite</footer>

  <script>
    async function loadRoute() {
      const res  = await fetch('/api/v1/transport/optimize');
      const data = await res.json();

      const emptyState   = document.getElementById('emptyState');
      const routeSummary = document.getElementById('routeSummary');
      const routeStops   = document.getElementById('routeStops');

      if (!data.optimized_route || data.optimized_route.length === 0) {
        emptyState.classList.remove('d-none');
        return;
      }

      const route = data.optimized_route;
      const first = route[0];

      // Summary bar
      routeSummary.classList.remove('d-none');
      document.getElementById('totalStops').textContent    = data.total_stops;
      document.getElementById('nextPickup').textContent    = first.pickup_time
        ? new Date(first.pickup_time).toLocaleDateString('en-GB', {day:'numeric', month:'short'})
        : '—';
      document.getElementById('truckAssigned').textContent = first.truck_id ?? '—';

      // Stop cards
      routeStops.innerHTML = route.map((stop, index) => `
        <div class="route-stop-card d-flex align-items-start gap-4 mb-4">
          <div class="stop-number">${index + 1}</div>
          <div class="flex-grow-1">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
              <div>
                <h5 class="fw-bold mb-1">${stop.farmer_name}</h5>
                <p class="text-muted mb-0" style="font-size:0.88rem">
                  Permit: <span class="badge bg-success">${stop.permit_number}</span>
                  &nbsp;·&nbsp; Tonnage: <strong>${stop.tonnage_capacity}t</strong>
                  &nbsp;·&nbsp; Truck: <strong>${stop.truck_id ?? '—'}</strong>
                </p>
              </div>
              <div class="text-end">
                ${index === 0
                  ? `<span class="badge route-badge-start">Starting Point</span>`
                  : `<span class="badge route-badge-dist">📍 ${stop.distance_from_previous_km} km from prev</span>`
                }
                <p class="text-muted mt-1 mb-0" style="font-size:0.8rem">
                  ${stop.pickup_time
                    ? new Date(stop.pickup_time).toLocaleString('en-GB',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'})
                    : '—'}
                </p>
              </div>
            </div>
            ${index < route.length - 1 ? '<div class="route-connector"></div>' : ''}
          </div>
        </div>
      `).join('');
    }

    loadRoute();
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
