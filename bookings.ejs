<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Bookings – Miwa</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="/styles.css" rel="stylesheet"/>
</head>
<body>

  <nav class="navbar navbar-expand-lg miwa-nav">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/">
        <img src="/photos/Sugarcane_Logo.jpeg" alt="Miwa Logo" class="nav-logo"/>
        Miwa
      </a>
      <div class="navbar-nav ms-auto d-flex flex-row gap-1">
        <a class="nav-link" href="/">Home</a>
        <a class="nav-link" href="/permits">Permits</a>
        <a class="nav-link active" href="/bookings">Bookings</a>
        <a class="nav-link" href="/analytics">Analytics</a>
      </div>
    </div>
  </nav>

  <!-- Page header -->
  <div class="page-header" style="background-image: url('/photos/field_seven.jpeg')">
    <div class="container page-header-content">
      <div class="text-white">
        <span class="hero-eyebrow">Miwa System</span>
        <h2 class="fw-bold mt-2 mb-1">Bookings & Deliveries</h2>
        <p class="mb-0" style="color:rgba(255,255,255,0.7)">Schedule pickups and track delivery status for each permit.</p>
      </div>
    </div>
  </div>

  <div class="container my-5">

    <!-- ── Create a new booking ── -->
    <div class="step-label">Create a New Booking</div>
    <div class="card shadow-sm mb-5 miwa-form-card">
      <div class="miwa-card-header">New Booking</div>
      <div class="card-body p-4">
        <form id="bookingForm">
          <div class="row g-3">
            <div class="col-md-3">
              <label class="form-label">Permit</label>
              <select class="form-select" id="permit_id" required>
                <option value="">Loading permits...</option>
              </select>
            </div>
            <div class="col-md-3">
              <label class="form-label">Pickup Date & Time</label>
              <input type="datetime-local" class="form-control" id="pickup_time" required/>
            </div>
            <div class="col-md-3">
              <label class="form-label">Truck ID</label>
              <input type="text" class="form-control" id="truck_id" placeholder="e.g. TRK-07" required/>
            </div>
            <div class="col-md-3 d-flex align-items-end">
              <button type="submit" class="btn btn-success w-100">Create Booking</button>
            </div>
          </div>
        </form>
        <div id="bookingMessage" class="mt-3"></div>
      </div>
    </div>

    <!-- ── All bookings table ── -->
    <div class="card shadow-sm miwa-form-card">
      <div class="miwa-card-header">All Bookings</div>
      <div class="card-body p-0">
        <table class="table table-hover mb-0">
          <thead>
            <tr>
              <th>ID</th>
              <th>Farmer</th>
              <th>Permit #</th>
              <th>Truck</th>
              <th>Pickup Time</th>
              <th>Tonnage</th>
              <th>Status</th>
              <th>Update</th>
            </tr>
          </thead>
          <tbody id="bookingsBody">
            <tr><td colspan="8" class="text-center text-muted py-4">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <footer>© 2026 Miwa Logistics · Built with Express & SQLite</footer>

  <script>
    const statusColors = {
      'scheduled':  'var(--turquoise)',
      'in-transit': '#f0ad4e',
      'delivered':  '#198754',
    };

    // Load approved permits into dropdown
    async function loadPermitOptions() {
      const res  = await fetch('/api/v1/permits/approved');
      const data = await res.json();
      const select = document.getElementById('permit_id');
      if (data.length === 0) {
        select.innerHTML = '<option value="">No active permits available</option>';
        return;
      }
      select.innerHTML = '<option value="">Select a permit...</option>' +
        data.map(p => `<option value="${p.id}">${p.permit_number} — ${p.farmer_name} (${p.tonnage_capacity}t)</option>`).join('');
    }

    // Load all bookings
    async function loadBookings() {
      const res  = await fetch('/api/v1/bookings');
      const data = await res.json();
      const tbody = document.getElementById('bookingsBody');

      if (data.length === 0) {
        tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">No bookings yet.</td></tr>';
        return;
      }

      tbody.innerHTML = data.map(b => `
        <tr>
          <td>${b.id}</td>
          <td><strong>${b.farmer_name}</strong></td>
          <td><span class="badge bg-success">${b.permit_number}</span></td>
          <td>${b.truck_id}</td>
          <td>${new Date(b.pickup_time).toLocaleString('en-GB',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'})}</td>
          <td>${b.tonnage_capacity}t</td>
          <td>
            <span class="badge" style="background:${statusColors[b.delivery_status]};color:#0D1F1F;font-weight:600">
              ${b.delivery_status}
            </span>
          </td>
          <td>
            <select class="form-select form-select-sm status-select" data-id="${b.id}" style="min-width:130px">
              <option value="scheduled"  ${b.delivery_status === 'scheduled'  ? 'selected' : ''}>Scheduled</option>
              <option value="in-transit" ${b.delivery_status === 'in-transit' ? 'selected' : ''}>In Transit</option>
              <option value="delivered"  ${b.delivery_status === 'delivered'  ? 'selected' : ''}>Delivered</option>
            </select>
          </td>
        </tr>
      `).join('');

      // Attach change listeners to all status dropdowns
      document.querySelectorAll('.status-select').forEach(select => {
        select.addEventListener('change', async (e) => {
          const id     = e.target.dataset.id;
          const status = e.target.value;
          const res = await fetch(`/api/v1/bookings/${id}/status`, {
            method:  'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ delivery_status: status }),
          });
          const data = await res.json();
          if (res.ok) {
            loadBookings(); // refresh table
          } else {
            alert(data.error);
          }
        });
      });
    }

    // Create booking
    document.getElementById('bookingForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const msgDiv = document.getElementById('bookingMessage');
      const body = {
        permit_id:   parseInt(document.getElementById('permit_id').value),
        pickup_time: document.getElementById('pickup_time').value,
        truck_id:    document.getElementById('truck_id').value,
      };
      const res  = await fetch('/api/v1/bookings/create', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify(body),
      });
      const data = await res.json();
      if (res.ok) {
        msgDiv.innerHTML = `<div class="alert alert-success">${data.message}</div>`;
        document.getElementById('bookingForm').reset();
        loadPermitOptions();
        loadBookings();
      } else {
        msgDiv.innerHTML = `<div class="alert alert-danger">${data.error}</div>`;
      }
    });

    loadPermitOptions();
    loadBookings();
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
