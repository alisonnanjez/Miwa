<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Analytics – Miwa</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="/styles.css" rel="stylesheet"/>
</head>
<body>

  <nav class="navbar navbar-expand-lg miwa-nav">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/">
        <img src="/photos/Sugarcane_Logo.jpeg" alt="Miwa Logo" class="nav-logo"/>
        Miwa
      </a>
      <div class="navbar-nav ms-auto d-flex flex-row gap-1">
        <a class="nav-link" href="/">Home</a>
        <a class="nav-link" href="/permits">Permits</a>
        <a class="nav-link active" href="/analytics">Analytics</a>
      </div>
    </div>
  </nav>

  <!-- Page header -->
  <div class="page-header" style="background-image: url('/photos/field_three.jpg')">
    <div class="container page-header-content">
      <div class="text-white">
        <span class="hero-eyebrow">Miwa System</span>
        <h2 class="fw-bold mt-2 mb-1">Analytics Dashboard</h2>
        <p class="mb-0" style="color:rgba(255,255,255,0.7)">Tonnage quotas, delivery performance, and efficiency metrics.</p>
      </div>
    </div>
  </div>

  <div class="container my-5">

    <!-- Summary cards (loaded dynamically) -->
    <div class="row g-4 mb-5" id="summaryCards">
      <div class="col-12 text-center text-muted py-3">Loading summary...</div>
    </div>

    <!-- Dashboard table -->
    <div class="card shadow-sm mb-5" style="border-radius:16px; overflow:hidden; border:1px solid rgba(10,191,188,0.2)">
      <div class="miwa-card-header">Tonnage Quota vs Deliveries</div>
      <div class="card-body p-0">
        <table class="table table-hover mb-0">
          <thead>
            <tr>
              <th>Farmer</th>
              <th>Acreage</th>
              <th>Total Quota (t)</th>
              <th>Total Bookings</th>
              <th>Completed</th>
              <th>Completion Rate</th>
            </tr>
          </thead>
          <tbody id="dashboardBody">
            <tr><td colspan="6" class="text-center text-muted py-4">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Efficiency table -->
    <div class="card shadow-sm" style="border-radius:16px; overflow:hidden; border:1px solid rgba(10,191,188,0.2)">
      <div class="miwa-card-header">⏱ Delivery Efficiency (Permit Issue → Pickup)</div>
      <div class="card-body p-0">
        <table class="table table-hover mb-0">
          <thead>
            <tr>
              <th>Farmer</th>
              <th>Permit #</th>
              <th>Expiry Date</th>
              <th>Pickup Time</th>
              <th>Days to Pickup</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody id="efficiencyBody">
            <tr><td colspan="6" class="text-center text-muted py-4">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <footer>© 2026 Miwa Logistics · Built with Express & SQLite</footer>

  <script>
    async function loadDashboard() {
      const res  = await fetch('/api/v1/analytics/dashboard');
      const data = await res.json();

      // Summary cards
      const totalQuota   = data.reduce((s, r) => s + (parseFloat(r.total_quota_tonnes) || 0), 0);
      const totalDone    = data.reduce((s, r) => s + parseInt(r.completed_deliveries || 0), 0);
      const totalBookings= data.reduce((s, r) => s + parseInt(r.total_deliveries || 0), 0);

      document.getElementById('summaryCards').innerHTML = `
        <div class="col-md-4">
          <div class="card text-center shadow-sm" style="border-radius:16px;border:1px solid rgba(10,191,188,0.2)">
            <div class="card-body py-4">
              <p class="section-label mb-1">Total Quota</p>
              <h2 style="font-family:'Playfair Display',serif;color:var(--turquoise)">${totalQuota.toFixed(1)}t</h2>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card text-center shadow-sm" style="border-radius:16px;border:1px solid rgba(10,191,188,0.2)">
            <div class="card-body py-4">
              <p class="section-label mb-1">Total Bookings</p>
              <h2 style="font-family:'Playfair Display',serif;color:var(--turquoise)">${totalBookings}</h2>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card text-center shadow-sm" style="border-radius:16px;border:1px solid rgba(10,191,188,0.2)">
            <div class="card-body py-4">
              <p class="section-label mb-1">Completed Deliveries</p>
              <h2 style="font-family:'Playfair Display',serif;color:var(--turquoise)">${totalDone}</h2>
            </div>
          </div>
        </div>
      `;

      // Table
      const tbody = document.getElementById('dashboardBody');
      tbody.innerHTML = data.map(row => {
        const rate = row.total_deliveries > 0
          ? Math.round((row.completed_deliveries / row.total_deliveries) * 100) : 0;
        const badgeColor = rate === 100 ? 'var(--turquoise)' : rate > 50 ? '#f0ad4e' : '#dc3545';
        return `
          <tr>
            <td><strong>${row.farmer_name}</strong></td>
            <td>${row.acreage} ac</td>
            <td>${row.total_quota_tonnes ?? '—'} t</td>
            <td>${row.total_deliveries}</td>
            <td>${row.completed_deliveries}</td>
            <td><span class="badge" style="background:${badgeColor};color:#0D1F1F;font-weight:600">${rate}%</span></td>
          </tr>
        `;
      }).join('');
    }

    async function loadEfficiency() {
      const res  = await fetch('/api/v1/analytics/efficiency');
      const data = await res.json();
      const tbody = document.getElementById('efficiencyBody');
      if (data.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">No completed deliveries yet.</td></tr>';
        return;
      }
      tbody.innerHTML = data.map(row => `
        <tr>
          <td><strong>${row.farmer_name}</strong></td>
          <td><span class="badge bg-success">${row.permit_number}</span></td>
          <td>${new Date(row.expiry_date).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'})}</td>
          <td>${new Date(row.pickup_time).toLocaleString('en-GB',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'})}</td>
          <td><strong>${row.days_to_pickup}</strong> days</td>
          <td><span class="badge" style="background:var(--mid);color:white">${row.delivery_status}</span></td>
        </tr>
      `).join('');
    }

    loadDashboard();
    loadEfficiency();
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
